# ── Claude ──────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── وضع التداول ─────────────────────────────────────
# paper = محاكاة (افتراضي وآمن) | live = تنفيذ حقيقي على المنصة
TRADING_MODE=paper
PAPER_STARTING_BALANCE=10000

# ── إدارة المخاطر ───────────────────────────────────
RISK_PER_TRADE_PCT=1.0        # أقصى خسارة لكل صفقة من رأس المال
MAX_DAILY_LOSS_PCT=3.0        # إيقاف التداول اليومي بعد هذه الخسارة
MAX_OPEN_POSITIONS=3
MIN_REWARD_RISK=1.5           # أقل نسبة عائد/مخاطرة مقبولة
MAX_POSITION_PCT=30           # أقصى نسبة من رأس المال في صفقة واحدة
ANALYSIS_MAX_AGE_MIN=60       # لا تُفتح صفقة دون تحليل حديث للرمز خلال هذه المدة
# ملاحظة: لا توجد رافعة إطلاقاً — التداول فوري وبالنقد المتوفر فقط (غير قابل للتعديل)

# ── أبحاث العملات الرقمية (اختياري — يرفع حد الطلبات المجاني) ──
COINGECKO_API_KEY=

# ── بينانس (للتنفيذ الحقيقي — حساب فوري Spot فقط) ──
CRYPTO_EXCHANGE=binance
# demo = تداول تجريبي بأسعار حقيقية وأموال وهمية (ابدأ هنا)
# testnet = الشبكة التجريبية القديمة | live = أموال حقيقية
BINANCE_ENV=demo
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
LIVE_MAX_ORDER_USD=50         # سقف قيمة الأمر الواحد بالدولار في المرحلة الأولى
REQUIRE_IP_WHITELIST=true     # يرفض النظام العمل الحقيقي إن لم يكن المفتاح مقيداً بعنوانك

# ── تنبيهات تيليجرام ────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── المستكشف التلقائي للفرص ─────────────────────────
EXPLORE_ENABLED=true
EXPLORE_EVERY_HOURS=4         # كل كم ساعة يمسح الأسواق (مجاني)
EXPLORE_AI_MAX_PER_DAY=2      # كم مرة يومياً يدرس الذكاء الاصطناعي المرشحين (مدفوع ~0.3-0.6$ للمرة)
EXPLORE_MIN_SCORE=75          # أقل درجة فنية لاعتبار السهم/العملة مرشحاً

# ── التنبيهات والشراء التلقائي ───────────────────────
ALERT_EXPIRY_DAYS=7           # صلاحية التنبيه/الخطة بالأيام
AUTO_BUY_MAX_CHASE_PCT=1.5    # لا يشتري إذا قفز السعر أبعد من هذه النسبة فوق الشرط
AUTO_BUY_LIVE=false           # الشراء التلقائي بأموال حقيقية معطّل حتى تجعله true

# ── النواة: الشراء الدوري الأسبوعي (استثمار طويل المدى) ──
DCA_ENABLED=true
DCA_WEEKLY_USD=100                          # المبلغ الأسبوعي بالدولار
DCA_ALLOCATION=BTC/USDT:60,ETH/USDT:40      # التوزيع بالنسب (أصول معتمدة شرعياً فقط)
DCA_WEEKDAY=0                               # 0 = الاثنين
DCA_HOUR_UTC=9                              # 9 = الساعة 12 ظهراً بتوقيت إسطنبول
DCA_LIVE=false                              # الشراء الدوري بأموال حقيقية معطّل حتى تجعله true

# ── ركوب الموجة (اختراق يومي + وقف متحرك) ───────────────
SWING_ENABLED=true
SWING_SYMBOLS=ETH/USDT        # فقط ما نجح في اختبار الثبات
SWING_MAX_CHASE_PCT=3         # لا يشتري إذا قفز السعر أكثر من هذه النسبة فوق الإشارة
