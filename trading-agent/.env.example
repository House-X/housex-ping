# ── Claude ──────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── وضع التداول ─────────────────────────────────────
# paper = محاكاة (افتراضي وآمن) | live = تنفيذ حقيقي على المنصة
TRADING_MODE=paper
PAPER_STARTING_BALANCE=10000

# ── إدارة المخاطر ───────────────────────────────────
RISK_PER_TRADE_PCT=1.0        # أقصى خسارة لكل صفقة من رأس المال
MAX_DAILY_LOSS_PCT=3.0        # إيقاف التداول اليومي بعد هذه الخسارة
MAX_OPEN_POSITIONS=3
MIN_REWARD_RISK=1.5           # أقل نسبة عائد/مخاطرة مقبولة
MAX_POSITION_PCT=30           # أقصى نسبة من رأس المال في صفقة واحدة
ANALYSIS_MAX_AGE_MIN=60       # لا تُفتح صفقة دون تحليل حديث للرمز خلال هذه المدة
# ملاحظة: لا توجد رافعة إطلاقاً — التداول فوري وبالنقد المتوفر فقط (غير قابل للتعديل)

# ── منصة العملات الرقمية (للوضع الحقيقي فقط — حساب فوري Spot فقط) ──
CRYPTO_EXCHANGE=binance
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_TESTNET=true         # ابدأ دائماً على الشبكة التجريبية
