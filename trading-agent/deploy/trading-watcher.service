[Unit]
Description=Trading agent watcher (stops, alerts, explorer, weekly core, swing, Telegram)
After=network-online.target
Wants=network-online.target

[Service]
User=trader
WorkingDirectory=/opt/trading-agent
ExecStart=/opt/trading-agent/.venv/bin/python main.py --watch
Restart=always
RestartSec=20
Environment=PYTHONUNBUFFERED=1 PYTHONIOENCODING=utf-8

[Install]
WantedBy=multi-user.target
